service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // INVOXA FIRESTORE SECURITY RULES
    // Project: Invoxa (Invoice, Billing & Customer Management)
    // Architecture: Root-Level Tenant Collections with Strict User Scoping
    // =========================================================================

    // -------------------------------------------------------------------------
    // HELPER FUNCTIONS
    // -------------------------------------------------------------------------

    // Check if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the authenticated user owns this document tree / user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify document belongs to current user by inspecting the 'userId' field
    function isResourceOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Verify incoming write assigns ownership to the current user
    function isIncomingResourceOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // 1. ROOT-LEVEL COLLECTIONS (PRIMARY ARCHITECTURE)
    // -------------------------------------------------------------------------

    // 1.1 USERS COLLECTION
    // Path: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 1.2 CUSTOMERS ROOT COLLECTION
    // Path: /customers/{customerId}
    match /customers/{customerId} {
      // Allow reading and deleting if authenticated and the document belongs to the user
      allow read, delete: if isResourceOwner();

      // Allow creating if authenticated, userId matches, and customer name is provided
      allow create: if isIncomingResourceOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;

      // Allow updating if authenticated and user retains ownership
      allow update: if isResourceOwner()
                    && isIncomingResourceOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
    }

    // 1.3 PRODUCTS ROOT COLLECTION
    // Path: /products/{productId}
    match /products/{productId} {
      allow read, delete: if isResourceOwner();

      allow create: if isIncomingResourceOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.unitPrice is number
                    && request.resource.data.unitPrice >= 0;

      allow update: if isResourceOwner()
                    && isIncomingResourceOwner()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.unitPrice is number
                    && request.resource.data.unitPrice >= 0;
    }

    // 1.4 INVOICES ROOT COLLECTION
    // Path: /invoices/{invoiceId}
    match /invoices/{invoiceId} {
      allow read, delete: if isResourceOwner();

      allow create: if isIncomingResourceOwner()
                    && request.resource.data.invoiceNumber is string
                    && request.resource.data.invoiceNumber.size() > 0
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0;

      allow update: if isResourceOwner()
                    && isIncomingResourceOwner()
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0;

      // 1.4.1 Invoice Line Items Subcollection
      match /items/{itemId} {
        allow read, write: if isAuthenticated()
                           && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.userId == request.auth.uid;
      }

      // 1.4.2 Invoice-Specific Payments Subcollection
      match /payments/{paymentId} {
        allow read, write: if isAuthenticated()
                           && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.userId == request.auth.uid;
      }
    }

    // 1.5 PAYMENTS ROOT COLLECTION
    // Path: /payments/{paymentId}
    match /payments/{paymentId} {
      allow read, delete: if isResourceOwner();
      allow create: if isIncomingResourceOwner()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow update: if isResourceOwner()
                    && isIncomingResourceOwner()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
    }

    // -------------------------------------------------------------------------
    // 2. NESTED SUBCOLLECTIONS UNDER USER (BACKWARD COMPATIBILITY & SUPPORT)
    // -------------------------------------------------------------------------
    // In case any legacy data or subcollections exist under /users/{userId}:
    // -------------------------------------------------------------------------

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // 3. COLLECTION GROUP RULES
    // -------------------------------------------------------------------------
    match /{path=**}/customers/{customerId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/products/{productId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/invoices/{invoiceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
>>>>>>> origin
    }
  }
}
